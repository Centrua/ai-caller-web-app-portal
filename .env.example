# Database credentials
DATABASE_URL=postgres://postgres:yourpassword@postgres:5432/appdb
PROD_DATABASE_URL=

# ElevenLabs credentials
ELEVENLABS_API_KEY=api_key
ELEVENLABS_TEMPLATE_AGENT_ID=template_agent_id
ELEVENLABS_CUSTOM_CHANNEL_TRIGGER_ID=trigger_connection_id
ELEVENLABS_CUSTOM_CHANNEL_INBOUND_SECRET=inbound_secret
ELEVENLABS_CUSTOM_CHANNEL_OUTBOUND_SIGNING_SECRET=outbound_signing_secret

# Nylas unified email API
NYLAS_API_KEY=
NYLAS_API_URI=https://api.us.nylas.com/v3
NYLAS_CLIENT_ID=
NYLAS_REDIRECT_URI="http://localhost:3001/api/auth/nylas/callback"
NYLAS_WEBHOOK_SECRET=
NYLAS_COMPANY_GRANT_ID=
# Comma-separated sender domains to ignore, for example: target.com,kohls.com
NYLAS_BLOCKED_SENDER_DOMAINS=kohls.com,target.com,walmart.com,bestbuy.com,macys.com,jcpenney.com,nordstrom.com,nordstromrack.com,tjmaxx.com,tjx.com,marshalls.com,homedepot.com,lowes.com,wayfair.com,overstock.com,qvc.com,hsn.com,amazon.com,amazonmail.com,ebay.com,etsy.com,groupon.com,retailmenot.com,slickdeals.net,rakuten.com,couponcabin.com,expedia.com,booking.com,hotels.com,tripadvisor.com,airbnb.com,linkedin.com,facebookmail.com,mail.instagram.com,pinterest.com,twitter.com,x.com,pinterestmail.com,spotify.com,netflix.com,hulu.com,disneyplus.com
INTERNAL_APPROVAL_EMAIL=approvals@yourcompany.com

# Node environment
NODE_ENV=development

JWT_SECRET=secret_key

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

