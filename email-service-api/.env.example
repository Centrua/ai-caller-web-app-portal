# Database credentials
DATABASE_URL=postgres://postgres:yourpassword@postgres:5432/appdb
PROD_DATABASE_URL=

# Node environment
NODE_ENV=development

# Gemini configs
GEMINI_API_KEY=your_actual_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Nylas API credentials
NYLAS_API_KEY=your_nylas_api_key_here
NYLAS_API_URI=https://api.us.nylas.com/v3
NYLAS_WEBHOOK_SECRET=your_nylas_webhook_secret_here

# Classifier settings
# Minimum confidence (0.0 - 1.0) required to mark an email as wedding inquiry
# Default: 0.8
CLASSIFIER_CONFIDENCE_THRESHOLD=0.8

# URL the email-service-api should use to reach the main backend.
# When running with docker-compose, use the `backend` service hostname: http://backend:3001
# On Docker Desktop for Windows/macOS you can also use host.docker.internal to reach the host: http://host.docker.internal:3001
BACKEND_URL=http://backend:3001
BACKEND_API_TOKEN=your_backend_api_token_here